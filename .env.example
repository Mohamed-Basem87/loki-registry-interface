PORT=8080
# true only when the UI is served over HTTPS; false for plain http://host:port
COOKIE_SECURE=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD_FILE=/run/secrets/registry_admin_password
SESSION_SECRET_FILE=/run/secrets/registry_session_secret

GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github_app_private_key
GITHUB_OWNER=Mohamed-Basem87
GITHUB_REPO=loki-freelance-assistant
GITHUB_BRANCH=main

# Host-published port of the sender's API, which may differ from the port its
# container listens on. Verify with GET $SENDER_API_BASE_URL/sources.
SENDER_API_BASE_URL=http://sender-gateway.tailnet:4090
# Optional. The current sender API does not enforce this header; use Tailscale ACLs.
SENDER_API_TOKEN=
